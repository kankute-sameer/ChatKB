# Public listener
APP_PORT=80

# PostgreSQL. Use a URL-safe value because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value

# Authentication
JWT_SECRET=replace-with-at-least-32-random-bytes
# Keep this value single-quoted so bcrypt "$" characters remain literal.
AUTH_USERS='{"admin":"replace-with-a-bcrypt-password-hash"}'
JWT_EXPIRE_DAYS=7

# OpenAI-compatible generation
LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna
LLM_TITLE_MODEL=gpt-5.6-luna
LLM_VISION_MODEL=gpt-5.6-luna

# Search and embeddings
EXA_API_KEY=replace-me
GEMINI_API_KEY=replace-me
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# AWS S3 document storage
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-1
S3_BUCKET=replace-me

# Optional Langfuse observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

LOG_LEVEL=INFO
