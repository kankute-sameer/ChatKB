# Generate a hash:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('yourpassword'))"
# Generate secret:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Build AUTH_USERS JSON:
#   python -c "import json; print(json.dumps({'alice': '<hash>', 'bob': '<hash>'}))"
#
# Example hashes below are for password: changeme  — replace before deploying.

JWT_SECRET=replace-with-token-urlsafe-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
AUTH_USERS={"alice":"$2b$12$2Mihl14KMfXvcYwJnvECqezW3wp0xNSJXspGTssThSk3UxntbreRS","bob":"$2b$12$0sG.NwwqJBVzjt8kOhglSuXa.RPKCKu5JnAmWkqKswZA2ndy3/xia"}
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+asyncpg://chatkb:chatkb@127.0.0.1:5433/chatkb
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna
LLM_TITLE_MODEL=gpt-5.6-luna
LLM_VISION_MODEL=gpt-5.6-luna
# low | medium | high | off  — off disables reasoning
LLM_REASONING_EFFORT=medium
# auto | concise | detailed
LLM_REASONING_SUMMARY=auto
EXA_API_KEY=
GEMINI_API_KEY=
IMAGE_MIN_DIMENSION_PX=64
MAX_CONCURRENT_IMAGE_DESCRIPTIONS=12
INGESTION_MODEL=gpt-5.6-luna
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# DEBUG | INFO | WARNING | ERROR  — DEBUG logs provider curls + raw chunks
LOG_LEVEL=DEBUG
